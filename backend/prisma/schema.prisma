// FreeQR - Prisma schema
// Provider: PostgreSQL (Neon). Pooled connection via DATABASE_URL for runtime,
// direct connection via DIRECT_URL for migrations/CLI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  USER
  ADMIN
}

enum QRType {
  URL
  TEXT
  EMAIL
  PHONE
  WIFI
  WHATSAPP
  CONTACT
  LOCATION
  EVENT
}

enum QRStatus {
  ACTIVE
  DISABLED
  EXPIRED
  DELETED
}

enum WifiEncryption {
  WPA
  WEP
  NOPASS
}

enum PatternStyle {
  SQUARE
  DOTS
  ROUNDED
}

enum EyeStyle {
  SQUARE
  CIRCLE
  ROUNDED
}

enum ErrorCorrection {
  L
  M
  Q
  H
}

enum FrameStyle {
  NONE
  SIMPLE
  ROUNDED
  BANNER
}

// ─────────────────────────── Models ──────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  qrCodes   QRCode[]
  folders   Folder[]
  auditLogs AuditLog[]

  @@index([email])
  @@map("users")
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  qrCodes QRCode[]

  @@index([userId])
  @@map("folders")
}

model QRCode {
  id        String   @id @default(cuid())
  userId    String
  folderId  String?
  name      String
  code      String   @unique
  type      QRType
  status    QRStatus @default(ACTIVE)
  scanCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  content       QRContent?
  customization QRCustomization?
  scans         Scan[]

  @@index([userId])
  @@index([folderId])
  @@index([code])
  @@index([status])
  @@map("qr_codes")
}

// Type-safe content model: explicit, nullable columns per QR type (no uncontrolled JSON blob).
model QRContent {
  id       String @id @default(cuid())
  qrCodeId String @unique

  // URL
  url String?

  // TEXT
  text String?

  // EMAIL
  email        String?
  emailSubject String?
  emailBody    String?

  // PHONE
  phone String?

  // WIFI
  wifiSsid       String?
  wifiPassword   String?
  wifiEncryption WifiEncryption?
  wifiHidden     Boolean?        @default(false)

  // WHATSAPP
  waNumber  String?
  waMessage String?

  // CONTACT / vCard
  firstName      String?
  lastName       String?
  organization   String?
  jobTitle       String?
  contactEmail   String?
  contactPhone   String?
  contactUrl     String?
  contactAddress String?

  // LOCATION
  latitude  Float?
  longitude Float?

  // EVENT
  eventTitle       String?
  eventDescription String?
  eventLocation    String?
  eventStart       DateTime?
  eventEnd         DateTime?

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("qr_contents")
}

model QRCustomization {
  id       String @id @default(cuid())
  qrCodeId String @unique

  foregroundColor String          @default("#0F172A")
  backgroundColor String          @default("#FFFFFF")
  patternStyle    PatternStyle    @default(SQUARE)
  eyeStyle        EyeStyle        @default(SQUARE)
  size            Int             @default(512)
  margin          Int             @default(2)
  errorCorrection ErrorCorrection @default(M)
  frameStyle      FrameStyle      @default(NONE)
  frameText       String?

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("qr_customizations")
}

model Scan {
  id        String   @id @default(cuid())
  qrCodeId  String
  scannedAt DateTime @default(now())

  deviceType      String?
  browser         String?
  operatingSystem String?
  country         String?
  region          String?
  city            String?

  // Privacy-safe: a salted hash of IP+UA per day, never the raw IP.
  visitorHash String?
  userAgent   String?

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([scannedAt])
  @@index([qrCodeId, scannedAt])
  @@index([visitorHash])
  @@map("scans")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

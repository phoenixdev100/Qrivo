# Base URL of the FreeQR backend REST API (versioned).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Base URL used to build scan tracking links shown to users ({BASE}/q/{code}).
NEXT_PUBLIC_SCAN_BASE_URL=http://localhost:5000

# Public site URL (used for SEO metadata / canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
